+    def _link_in_wasm_libraries(self):
+        """
+        Link the dependent libraries into the final module like on native
+        targets, then give the linked-in function definitions internal
+        linkage.
+
+        Internalizing has to happen after linking: an internal definition in
+        the source module would not resolve the external declarations in
+        this module. Global variables (e.g. the weak NumbaEnv pointers) are
+        left alone, so they still resolve through the GOT to the definition
+        in the side module that was loaded first.
+        """
+        own_definitions = {
+            fn.name for fn in self._final_module.functions
+            if not fn.is_declaration
+        }
+        linked_definitions = set()
+        seen = set()
+        for library in self._linking_libraries:
+            if library in seen:
+                continue
+            seen.add(library)
+            # Parent inherits reload_init
+            self._reload_init.update(library._reload_init)
+            module = library._get_module_for_linking()
+            linked_definitions.update(
+                fn.name for fn in module.functions if not fn.is_declaration
+            )
+            self._final_module.link_in(module, preserve=True)
+
+        # The linker only copies linkonce_odr definitions that this module
+        # references, so not every linked definition is present here.
+        candidates = linked_definitions - own_definitions
+        internalized = 0
+        for fn in self._final_module.functions:
+            if fn.name in candidates and not fn.is_declaration:
+                fn.linkage = 'internal'
+                internalized += 1
+
+        wasm_trace.log(
+            "llvm",
+            f"module {self.name!r}: linked {len(seen)} library(ies), "
+            f"internalized {internalized} function(s)",
+        )
+
